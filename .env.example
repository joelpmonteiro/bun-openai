PORT=4500
HOST=127.0.0.1
APMIX_BASE_URL=https://api.apmix.ai/v1
# Server credentials. Leave blank to forward the client's APMix key.
APMIX_API_KEY=
# Optional comma-separated keys; takes precedence over APMIX_API_KEY.
APMIX_API_KEYS=
APMIX_KEY_COOLDOWN_MS=30000
APMIX_MODELS_CACHE_TTL_MS=60000
APMIX_TIMEOUT_MS=120000
# Optional local credential. Requires a server-side APMIX_API_KEY(S).
PROXY_API_KEY=
